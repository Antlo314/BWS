rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (default-deny catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow public read on the connection test document for offline checking
    match /test/connection {
      allow read: if true;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for BWS ledger Trade entities
    function isValidTrade(data) {
      return data.keys().hasAll(['id', 'timestamp', 'hash', 'sourceName', 'tradeType', 'bwsxAmount', 'customMsg', 'userId', 'email'])
        && data.keys().size() == 9
        && data.id is string && data.id.size() <= 128
        && data.timestamp is string && data.timestamp.size() <= 64
        && data.hash is string && data.hash.size() <= 128
        && data.sourceName is string && data.sourceName.size() <= 100
        && data.tradeType is string && data.tradeType.size() <= 100
        && data.bwsxAmount is string && data.bwsxAmount.size() <= 50
        && data.customMsg is string && data.customMsg.size() <= 500
        && data.userId is string && data.userId == request.auth.uid
        && data.email is string && data.email == request.auth.token.email;
    }

    // Validation helper for BWS Profiles
    function isValidProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'bio', 'organization', 'balance', 'spending', 'classesMastered', 'role', 'createdAt'])
        && data.keys().size() >= 10 && data.keys().size() <= 12
        && data.uid is string && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.bio is string && data.bio.size() <= 1200
        && data.organization is string && data.organization.size() <= 150
        && (data.balance is number || data.balance is int)
        && (data.spending is number || data.spending is int)
        && (data.classesMastered is number || data.classesMastered is int)
        && data.role is string && (data.role == 'user' || data.role == 'admin')
        && data.createdAt is string
        && (!data.keys().hasAll(['savedLessons']) || (data.savedLessons is list && data.savedLessons.size() <= 100))
        && (!data.keys().hasAll(['lessonNotes']) || (data.lessonNotes is map));
    }

    // Trades collection rules
    match /trades/{tradeId} {
      // Allow read (get and list queries) for any authenticated cooperator to experience a true Shared Ledger
      allow read: if isSignedIn();

      // Create new permanent trade ledger receipts
      allow create: if isEmailVerified()
        && isValidId(tradeId)
        && isValidTrade(incoming());

      // Ledger records are strictly immutable and cannot be updated or deleted
      allow update: if false;
      allow delete: if false;
    }

    // Profiles collection rules
    match /profiles/{userId} {
      // Read is open to cooperators to promote directory building
      allow read: if isSignedIn();

      // Initiate default user profile creation during initial activation
      allow create: if isSignedIn()
        && userId == request.auth.uid
        && isValidProfile(incoming())
        && incoming().role == 'user'; // Users can never sign themselves up as admin initially

      // Rules protecting stats and forbidding role spoofing/escalating
      allow update: if isSignedIn() && (
        // Case 1: User updating their own profile details, but keeping role/balance/spending lock steps
        (userId == request.auth.uid 
          && isValidProfile(incoming()) 
          && incoming().role == existing().role
        ) ||
        // Case 2: Certified corporate admin override looking up profiles document
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
          && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin'
        )
      );

      // Only administrators can remove sovereign standing accounts
      allow delete: if isSignedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    // Vault resources cooperative sharing rules
    match /vault_resources/{resourceId} {
      // Public read encourages pooling trust visibility
      allow read: if true;

      // Any signed in verified user can seed/catalog resources or update reserve bookings
      allow create: if isSignedIn() && isValidId(resourceId);
      allow update: if isSignedIn() && isValidId(resourceId);
      allow delete: if isSignedIn();
    }
  }
}
